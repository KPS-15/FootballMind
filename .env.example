# Environment Variables
FOOTBALLMIND_ENV=development
FOOTBALLMIND_LOG_LEVEL=INFO
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8000
DATABASE_URL=sqlite:///./footballmind.db
MODELS_DIR=./models
UPLOADS_DIR=./uploads

# Roboflow Serverless Workflow API
ROBOFLOW_API_URL=https://serverless.roboflow.com
ROBOFLOW_API_KEY=your_roboflow_api_key_here
ROBOFLOW_WORKSPACE=your_workspace_here
ROBOFLOW_WORKFLOW_ID=your_workflow_id_here
